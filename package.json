{
  "name": "devadviento",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @np/web --filter @np/api dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "tickets:generate": "pnpm --filter @np/tickets generate",
    "tickets:verify": "pnpm --filter @np/tickets verify"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "postgres": "^3.4.7",
    "typescript": "~5.9.3"
  }
}
