{
  "name": "@np/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/node.ts",
    "dev:worker": "wrangler dev",
    "build": "esbuild src/node.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/node.mjs",
    "start": "node dist/node.mjs",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@np/shared": "workspace:*",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4",
    "wrangler": "^4.162.0"
  }
}
