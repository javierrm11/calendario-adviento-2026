# Copia este archivo como .env (raíz: API y migraciones) y como apps/web/.env.local (web).

# --- Supabase ---------------------------------------------------------------
# Públicas: se pueden ver en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta: solo servidor. Salta las políticas RLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Conexión directa a Postgres, solo para `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- API del Polo Norte -----------------------------------------------------
# Secreto compartido entre la web (firma tokens y ejecuciones) y la API (comprueba tokens).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NP_TOKEN_SECRET=cambia-esto-por-64-caracteres-hexadecimales
# URL pública de la API: la llama el navegador de cada participante.
# En local: http://localhost:8787 · En producción: la URL de tu Worker de Cloudflare.
NP_API_URL=http://localhost:8787

# --- Desarrollo -------------------------------------------------------------
# Simula la fecha actual (solo fuera de producción). Ejemplo: día 12 a las 7:00.
# NP_FECHA_SIMULADA=2026-12-12T07:00:00+01:00
