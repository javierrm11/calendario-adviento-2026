# Copia este archivo como .env (raíz: API y migraciones) y como apps/web/.env.local (web).
# Los valores van vacíos a propósito: los escáneres de secretos marcan cualquier ejemplo con pinta de clave.

# --- Supabase ---------------------------------------------------------------
# Públicas: se pueden ver en el navegador. Project Settings → API Keys.
# URL con la forma https://<proyecto>.supabase.co; la clave empieza por sb_publishable_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta: solo servidor, salta las políticas RLS. Empieza por sb_secret_
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a Postgres, solo para `pnpm db:migrate`. Database → Connection string.
DATABASE_URL=

# --- API del Polo Norte -----------------------------------------------------
# Secreto compartido entre la web (firma tokens y ejecuciones) y la API (comprueba tokens).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NP_TOKEN_SECRET=
# URL pública de la API: la llama el navegador de cada participante.
# En local: http://localhost:8787 · En producción: la URL de tu Worker de Cloudflare.
NP_API_URL=http://localhost:8787

# --- Desarrollo -------------------------------------------------------------
# Simula la fecha actual (solo fuera de producción). Ejemplo: día 12 a las 7:00.
# NP_FECHA_SIMULADA=2026-12-12T07:00:00+01:00
